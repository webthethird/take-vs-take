# Copy to .env and fill in. .env is gitignored; never commit real values.

# Tiingo end-of-day prices. Get a token at https://www.tiingo.com/account/api/token
TIINGO_API_TOKEN=

# Your Tiingo plan: "starter" (default) or "power". Starter's terms forbid
# storing Tiingo data or results derived from it, so prices are refetched
# every run and no report is saved. Power allows both. If you downgrade,
# delete .cache/prices first: the app refuses to start on Starter while it
# exists.
TIINGO_PLAN=starter

# Anthropic API, for thesis analysis and portfolio drafts. Billed per token;
# the pipeline enforces its own spend cap (see LLM_BUDGET_USD).
# Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Hard ceiling on LLM spend per process, in US dollars. Calls that would
# exceed it fail instead of running.
LLM_BUDGET_USD=5

# X API bearer token (console.x.com), for fetching posts that aren't saved
# as fixtures. Billed per post read; set a spending limit in the console and
# leave auto-recharge off. Unset, only the saved example pairs resolve.
# Responses are cached under .cache/x for at most 30 days.
X_BEARER_TOKEN=
