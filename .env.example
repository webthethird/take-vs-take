# Copy to .env and fill in. .env is gitignored; never commit real values.

# Tiingo end-of-day prices. Free "Starter" tier is licensed for personal /
# internal use only — fine for local development, not for a public demo.
# Get a token at https://www.tiingo.com/account/api/token
TIINGO_API_TOKEN=

# Anthropic API, for thesis analysis and portfolio drafts. Billed per token;
# the pipeline enforces its own spend cap (see LLM_BUDGET_USD).
# Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Hard ceiling on LLM spend per process, in US dollars. Calls that would
# exceed it fail instead of running.
LLM_BUDGET_USD=5
